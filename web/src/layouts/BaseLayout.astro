---
import "../styles/index.less";
import SiteHeader from "../components/SiteHeader.astro";
import { fetchContact, fetchTerms, fetchCredits } from "../lib/strapi";

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  greenMenu?: boolean;
  currentSlug?: string;
}

const {
  title = "Bastion Tower",
  description,
  locale = "en",
  greenMenu = false,
  currentSlug,
} = Astro.props;

const [contact, terms, credits] = await Promise.all([
  fetchContact(locale),
  fetchTerms(locale),
  fetchCredits(locale).catch(() => null),
]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/custom-styles.css" />
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class="container">
      <SiteHeader
        locale={locale}
        greenMenu={greenMenu}
        currentSlug={currentSlug}
      />
      <slot />
      <section class="section section--bg-green">
        <div class="contact section__inner" id="contact">
          <h1 class="section__title contact--section-title">
            {contact.title}
          </h1>
          <div class="contact__text">
            <Fragment set:html={contact.text ?? ""} />
            <a
              href="javascript:void(9)"
              class="icon icon--arrow-circle-top contact__button contact__button--rouded"
              data-behavior="scroll-to-top"
              aria-label="Scroll to top"></a>
          </div>
        </div>
      </section>
      <footer class="footer">
        <div class="footer__inner">
          <a href={`/${locale}/terms`} class="footer__link"
            >{terms.footer_title}</a
          >
          {
            credits && (
              <a href={`/${locale}/credits`} class="footer__link">
                {credits.footer_title}
              </a>
            )
          }
        </div>
      </footer>
    </div>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // --- ScrollSpy ---
        var enterEls = document.querySelectorAll("[data-spy-enter-viewport]");
        if (enterEls.length) {
          var enterObs = new IntersectionObserver(function (entries, obs) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              entry.target.setAttribute("data-enter-viewport", "true");
              obs.unobserve(entry.target);
            });
          }, { threshold: 0 });
          enterEls.forEach(function (el) { enterObs.observe(el); });
        }
        var viewportEls = document.querySelectorAll("[data-spy-viewport]");
        if (viewportEls.length) {
          var viewportObs = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              entry.target.setAttribute("data-viewport", entry.isIntersecting ? "true" : "false");
            });
          }, { threshold: 0 });
          viewportEls.forEach(function (el) { viewportObs.observe(el); });
        }

      });
    </script>
  </body>
</html>
