---
import "../styles/index.less";
import SiteHeader from "../components/SiteHeader.astro";
import { fetchContact, fetchTerms, fetchCredits } from "../lib/strapi";

interface Props {
  title?: string;
  description?: string;
  locale?: string;
  greenMenu?: boolean;
  currentSlug?: string;
}

const {
  title = "Bastion Tower",
  description,
  locale = "en",
  greenMenu = false,
  currentSlug,
} = Astro.props;

const [contact, terms, credits] = await Promise.all([
  fetchContact(locale),
  fetchTerms(locale),
  fetchCredits(locale).catch(() => null),
]);
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/custom-styles.css" />
    {title && <title>{title}</title>}
    {description && <meta name="description" content={description} />}
  </head>
  <body>
    <div class="container">
      <SiteHeader
        locale={locale}
        greenMenu={greenMenu}
        currentSlug={currentSlug}
      />
      <slot />
      <section class="section section--bg-green">
        <div class="contact section__inner" id="contact">
          <h1 class="section__title contact--section-title">
            {contact.title}
          </h1>
          <div class="contact__text">
            <Fragment set:html={contact.text ?? ""} />
            <a
              href="javascript:void(9)"
              class="icon icon--arrow-circle-top contact__button contact__button--rouded"
              data-behavior="scroll-to-top"
              aria-label="Scroll to top"></a>
          </div>
        </div>
      </section>
      <footer class="footer">
        <div class="footer__inner">
          <a href={`/${locale}/terms`} class="footer__link"
            >{terms.footer_title}</a
          >
          {
            credits && (
              <a href={`/${locale}/credits`} class="footer__link">
                {credits.footer_title}
              </a>
            )
          }
        </div>
      </footer>
    </div>
    <script is:inline>
      document.addEventListener("DOMContentLoaded", function () {
        // --- ScrollSpy ---
        const enterEls = document.querySelectorAll("[data-spy-enter-viewport]");
        if (enterEls.length) {
          const enterObs = new IntersectionObserver(
            function (entries, obs) {
              entries.forEach(function (entry) {
                if (!entry.isIntersecting) return;
                entry.target.setAttribute("data-enter-viewport", "true");
                obs.unobserve(entry.target);
              });
            },
            { threshold: 0 },
          );
          enterEls.forEach(function (el) {
            enterObs.observe(el);
          });
        }
        const viewportEls = document.querySelectorAll("[data-spy-viewport]");
        if (viewportEls.length) {
          const viewportObs = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (entry) {
                entry.target.setAttribute(
                  "data-viewport",
                  entry.isIntersecting ? "true" : "false",
                );
              });
            },
            { threshold: 0 },
          );
          viewportEls.forEach(function (el) {
            viewportObs.observe(el);
          });
        }

        // --- Slider ---
        function slidesPerPage(slider) {
          const slide = slider.slides[slider.current];
          if (!slide) return 1;
          const basis = parseFloat(window.getComputedStyle(slide).flexBasis);
          return basis > 0 ? Math.max(Math.floor(100 / basis), 1) : 1;
        }
        function loopIndex(slider, index) {
          const n = slider.slides.length;
          index = ((index % n) + n) % n;
          if (n - index < slidesPerPage(slider)) index = 0;
          return index;
        }
        function sliderGo(slider, index) {
          const spp = slidesPerPage(slider);
          slider.slides.forEach(function (slide, l) {
            slide.classList.toggle("our-slider__slide--current", l === index);
            slide.classList.toggle("our-slider__slide--next", l > index);
            slide.classList.toggle("our-slider__slide--previous", l < index);
          });
          slider.slidesEl.style.transform =
            "translate3d(" + (-index * 100) / spp + "%, 0, 0)";
          slider.current = index;
          slider.container.classList.toggle(
            "our-slider--first-slide",
            index === 0,
          );
          slider.container.classList.toggle(
            "our-slider--last-slide",
            index === slider.slides.length - 1,
          );
        }
        function initSlider(container) {
          const delay = container.hasAttribute("data-slider-delay")
            ? parseInt(container.getAttribute("data-slider-delay"))
            : 6000;
          const slidesEl = container.querySelector(
            "[data-behavior='slider-slides']",
          );
          if (!slidesEl) return;
          const slideEls = Array.from(
            slidesEl.querySelectorAll("[data-behavior='slider-slide']"),
          );
          if (!slideEls.length) return;
          container.removeAttribute("data-behavior");
          container.classList.add("our-slider");
          slidesEl.classList.add("our-slider__slides");
          slideEls.forEach(function (s) {
            s.classList.add("our-slider__slide");
          });
          const slider = {
            container: container,
            slidesEl: slidesEl,
            slides: slideEls,
            current: 0,
            timer: null,
          };
          sliderGo(slider, 0);
          slider.timer = setInterval(function () {
            sliderGo(slider, loopIndex(slider, slider.current + 1));
          }, delay);
          let touchStartX = 0;
          container.addEventListener(
            "touchstart",
            function (e) {
              touchStartX = e.touches[0].clientX;
              slidesEl.classList.add("our-slider__slides--dragging");
              clearInterval(slider.timer);
            },
            { passive: true },
          );
          container.addEventListener(
            "touchend",
            function (e) {
              const dx = e.changedTouches[0].clientX - touchStartX;
              slidesEl.classList.remove("our-slider__slides--dragging");
              const threshold = container.clientWidth * 0.3;
              if (dx < -threshold)
                sliderGo(slider, loopIndex(slider, slider.current + 1));
              else if (dx > threshold)
                sliderGo(slider, loopIndex(slider, slider.current - 1));
              else sliderGo(slider, slider.current);
            },
            { passive: true },
          );
        }
        document
          .querySelectorAll("[data-behavior='slider']")
          .forEach(initSlider);
      });
    </script>
  </body>
</html>
