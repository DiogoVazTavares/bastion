---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import Paragraph from "../../components/blocks/Paragraph.astro";
import ParagraphImage from "../../components/blocks/ParagraphImage.astro";
import BuildingBlock from "../../components/blocks/Building.astro";
import Partners from "../../components/blocks/Partners.astro";
import { fetchBuilding } from "../../lib/strapi";

export const getStaticPaths = (async () => {
  const locales = ["en", "fr", "nl"];

  const pages = await Promise.all(
    locales.map(async (locale) => {
      const building = await fetchBuilding(locale);
      return { params: { locale }, props: { building, locale } };
    }),
  );

  return pages;
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { building, locale } = Astro.props;

// Compute paragraph-image directions via cross-block textimagecount (mirrors _Section.cshtml logic)
let textimagecount = 0;
const blockDirections = building.blocks.map((block: any) => {
  if (block.__component === "blocks.building") {
    block.items?.forEach((item: any) => {
      if (item.small_image) textimagecount++;
    });
    return null;
  }
  if (block.__component === "blocks.paragraph-image") {
    const direction = textimagecount % 2 === 0 ? "right" : "left";
    textimagecount++;
    return direction;
  }
  return null;
});
---

<BaseLayout
  title={building.browser_title ?? building.title ?? undefined}
  description={building.google_description ?? undefined}
  locale={locale}
  currentSlug="building"
>
  <Hero title={building.hero} image={building.image} video={null} />
  <div id="content" tabindex="-1"></div>
  {
    building.blocks.map((block: any, i: number) => {
      if (block.__component === "blocks.paragraph") {
        return <Paragraph {...block} />;
      }
      if (block.__component === "blocks.paragraph-image") {
        return (
          <ParagraphImage
            {...block}
            direction={blockDirections[i] as "left" | "right"}
          />
        );
      }
      if (block.__component === "blocks.building") {
        return <BuildingBlock {...block} />;
      }
      if (block.__component === "blocks.partners") {
        return <Partners {...block} />;
      }
      return null;
    })
  }
</BaseLayout>
