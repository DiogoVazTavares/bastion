---
interface Props {
  title: string | null;
  show: boolean;
  show_title: boolean;
  background_color: "White" | "Lightgray" | "Gray" | "Blue";
  items: Array<{
    image: { url: string; alternativeText: string | null } | null;
    text: string | null;
  }>;
}

const { title, show, show_title, background_color, items } = Astro.props;

const bgClass: Record<string, string> = {
  Lightgray: "section--bg-light-gray",
  Gray: "section--bg-gray",
  Blue: "section--bg-green",
};

const sectionClass = ["section", bgClass[background_color]]
  .filter(Boolean)
  .join(" ");
---

{
  show && (
    <div class={sectionClass} data-spy-enter-viewport>
      <div class="section__inner">
        {show_title && title && <h4 class="section__title">{title}</h4>}
        <div class="info">
          <div class="info__inner">
            {items.map((item) => (
              <div class="info__item">
                {item.image && (
                  <div class="info__image">
                    <img src={item.image.url} alt={item.image.alternativeText ?? ""} />
                  </div>
                )}
                <div class="info__text">
                  <Fragment set:html={item.text ?? ""} />
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  )
}
