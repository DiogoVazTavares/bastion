---
interface Props {
  title: string | null;
  text: string | null;
  image: { url: string; alternativeText: string | null } | null;
  show: boolean;
  show_title: boolean;
  background_color: "White" | "Lightgray" | "Gray" | "Blue";
}

const { title, text, image, show, show_title, background_color } = Astro.props;

const bgClass: Record<string, string> = {
  Lightgray: "section--bg-light-gray",
  Gray: "section--bg-gray",
  Blue: "section--bg-green",
};

const sectionClass = ["section", bgClass[background_color]]
  .filter(Boolean)
  .join(" ");
---

{
  show && (
    <div class={sectionClass}>
      <div class="section__inner">
        {show_title && title && <h4 class="section__title">{title}</h4>}
        <div class="paragraph-image">
          <div class="paragraph-image__inner paragraph-image--right">
            <div class="paragraph-image__container">
              <div class="paragraph-image__text">
                <Fragment set:html={text ?? ""} />
              </div>
            </div>
            {image && (
              <div class="paragraph-image__container">
                <div class="paragraph-image__image">
                  <img src={image.url} alt={image.alternativeText ?? ""} />
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  )
}
