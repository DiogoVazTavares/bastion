{
  "collectionName": "components_blocks_partners",
  "info": {
    "displayName": "Partners",
    "icon": "grid",
    "description": "PanelPartners — title, HTML text, image array"
  },
  "options": {},
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "text": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "bastion"
      },
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "images": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "show": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "show_title": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "background_color": {
      "type": "enumeration",
      "enum": ["White", "Lightgray", "Gray", "Green"],
      "default": "White",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
